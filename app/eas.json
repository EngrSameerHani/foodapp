{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:8000/api/v1",
        "EXPO_PUBLIC_WS_URL": "ws://localhost:8000/ws"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://REPLACE_WITH_YOUR_RAILWAY_URL/api/v1",
        "EXPO_PUBLIC_WS_URL": "wss://REPLACE_WITH_YOUR_RAILWAY_URL/ws"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://REPLACE_WITH_YOUR_RAILWAY_URL/api/v1",
        "EXPO_PUBLIC_WS_URL": "wss://REPLACE_WITH_YOUR_RAILWAY_URL/ws"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
